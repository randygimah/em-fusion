.DS_store
.worktrees/

# Secrets. backend/.gitignore already covers backend/.env; this covers a root
# one, which nothing ignores today and which is where a compose user would
# naturally put a provider key. .env.example is the committed template.
.env
.env.*
!.env.example

# OpenSky corpus. The Data License Agreement s3(iii) forbids making the data
# available to anyone outside the licensee's institute, so neither the raw
# hourly file nor the filtered extract may be committed. manifest.json,
# coverage.json, and the fetch script are the committed artefacts — see
# docs/qa.md 21 and spec adp-004.
data/opensky/raw/
data/opensky/*.parquet

# Structurizr: workspace.dsl is the source of truth. These are regenerated on every
# `structurizr local` run and would otherwise churn in every diff.
docs/architecture/workspace.json
docs/architecture/.structurizr/
docs/architecture/exports/

# Derived zone data cached by measurements/corpus/source_gap_threshold_sweep.py.
# Regenerable from the corpus; never committed.
backend/measurements/.zone_cache.json

# Knowledge graph built by the graphify skill. Derived from the repo and
# regenerable with one command, so committing it would store 16 MB of churn per
# rebuild and leave a graph that still renders after the code beneath it moved.
# .graphify_python holds an absolute path to one machine's interpreter.
graphify-out/

# Mutation harness crash guard (measurements/mutation/*.in-progress.json)
*.in-progress.json
