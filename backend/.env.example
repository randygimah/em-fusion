# Copy to .env and adjust.
# Compose supplies these to the containers directly; they matter for running the
# backend natively against the Compose database.

# Reachable as `postgis` inside Compose, `localhost` from the host.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/em_fusion

# Read by compose.yaml when starting the database container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=em_fusion
# Change if 5432 is already taken by a native Postgres install.
POSTGRES_PORT=5432

# Pseudonymisation seed for aircraft identifiers (dal-004). Any non-empty
# string; there is deliberately no default, and the backend fails loudly
# without it rather than falling back to one.
#
# NEVER COMMIT THE REAL VALUE, and never put it in data/opensky/manifest.json.
# icao24 is a 24-bit space, so publishing the seed lets anyone reconstruct the
# whole mapping by exhaustive search and undoes the de-identification OpenSky
# DLA section 3(i) requires. The manifest records its SHA-256 fingerprint
# instead, which identifies which seed built a corpus without disclosing it.
#
# Changing it is a corpus-level event: every aircraft gets a new pseudonym, so
# rebuild the corpus and let build_corpus rewrite the manifest.
PSEUDONYM_SEED=change-me-to-something-unguessable
