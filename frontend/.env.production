# Committed frontend settings (map-001). Vite publishes every VITE_ variable into
# the bundle, so nothing here may be a secret.
#
# The default basemap, served from this origin. Fetch it with `make basemap`.
# Empty means no basemap: the map shows a labelled placeholder (map-002).
VITE_BASEMAP_ARCHIVE=/basemap/em-fusion.pmtiles
#
# Optional satellite imagery, off unless BOTH are set: an XYZ tile URL with
# {z}/{x}/{y} and the attribution its provider requires. Set them in
# .env.development.local or .env.production.local (gitignored), never here.
# VITE_SATELLITE_TILES=
# VITE_SATELLITE_ATTRIBUTION=
